  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:frontend && node scripts/postbuild.js",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "admin:password": "node backend/change-password.js",
    "sync:turso": "node backend/sync-local-to-turso.js",
    "migrate": "node backend/migrate.js",
    "migrate:cms": "node backend/migrate-cms.js",
    "migrate:email": "node backend/migrate-email.js",
    "seed": "node backend/seed.js",
    "setup": "node backend/migrate.js && node backend/seed.js && node backend/migrate-cms.js && node backend/migrate-email.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cr4zyCute/omnivirtualSolutions.git"
  },
